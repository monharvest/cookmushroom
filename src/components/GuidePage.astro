---
import Layout from '../layouts/Layout.astro';
import type { GuideArticle } from '../data/guides';
import { cookTimes, recipeCards } from '../data/guides';
import ShareRow from './ShareRow.astro';
import CookMode from './CookMode.astro';
import { inlineMarkup } from '../lib/richtext';
import RelatedCards from './RelatedCards.astro';

const { guide } = Astro.props as { guide: GuideArticle };
const seoTitle = guide.title.length + ' | CookMushroom'.length <= 60 ? `${guide.title} | CookMushroom` : guide.title;
const relatedRows = cookTimes.filter((row) => guide.mushroomSlug ? row.mushroomSlug === guide.mushroomSlug : row.methodSlug === 'pan').slice(0, 3);
const relatedRecipes = recipeCards.filter((recipe) => recipe.guide === guide.slug && recipe.href !== `/${guide.slug}/`).slice(0, 3);
const primaryCookTime = relatedRows[0]?.time ?? guide.isoTime.replace(/^PT/, '').toLowerCase();
const updatedDisplay = new Date(`${guide.updated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const pageUrl = new URL(`/${guide.slug}/`, 'https://cookmushroom.com').toString();
const imageUrl = guide.image ? new URL(guide.image, 'https://cookmushroom.com').toString() : undefined;
const heroImageSizes = '(max-width: 720px) 100vw, (max-width: 1120px) 90vw, 960px';
const heroImageSrcset = guide.image?.endsWith('.webp')
  ? [600, 900, 1200].map((width) => `${width === 1200 ? guide.image : guide.image.replace(/\.webp$/, `-${width}.webp`)} ${width}w`).join(', ')
  : undefined;
const author = { '@type': 'Person', name: 'Ana' };
const publisher = {
  '@type': 'Organization',
  name: 'CookMushroom',
  url: 'https://cookmushroom.com/about/',
  logo: { '@type': 'ImageObject', url: 'https://cookmushroom.com/logo.png' },
};

const minutesOf = (iso?: string) => iso?.match(/^PT(\d+)M$/)?.[1];
const prepMinutes = minutesOf(guide.prepIsoTime);
const cookMinutes = minutesOf(guide.isoTime);
const totalIsoTime = prepMinutes && cookMinutes ? `PT${Number(prepMinutes) + Number(cookMinutes)}M` : guide.isoTime;
// Section count doesn't discriminate: the fixed sections (method, cook times,
// fixes, storage, FAQs) push every guide to ~8 entries regardless of depth, so
// a 750-word page would get the same contents box as a 2,300-word one. Gate on
// how much text is actually on the page instead.
const countWords = (...parts: (string | string[] | undefined)[]) =>
  parts.flat().filter(Boolean).join(' ').trim().split(/\s+/).filter(Boolean).length;

// Table of contents, built from the same data the body renders below so the
// two can't drift. Only the sections a reader might jump to — the tail
// (pairings, related links, sources) is skipped. Threshold is total entries
// rather than section count: a two-section guide still carries method, cook
// times, fixes and FAQs.
const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const methodId = guide.ingredients ? 'recipe' : 'method';
const methodHeading = guide.ingredients
  ? (guide.recipeName ?? 'The recipe')
  : (guide.sections ? 'Fast method' : 'Method');
const toc = [
  ...(guide.sections ?? []).map((section) => ({ id: slugify(section.heading), label: section.heading })),
  { id: methodId, label: methodHeading },
  ...(guide.showCookTimes !== false && relatedRows.length > 0 ? [{ id: 'cook-times', label: 'Cook times' }] : []),
  { id: 'small-fixes', label: 'Small fixes that matter' },
  ...(guide.variations ? [{ id: 'variations', label: 'Variations' }] : []),
  ...(guide.storage ? [{ id: 'storage', label: 'Storage and reheating' }] : []),
  ...(guide.faqs ? [{ id: 'faqs', label: 'Frequently asked questions' }] : []),
];
const guideWords = countWords(
  guide.description,
  ...(guide.sections ?? []).flatMap((section) => [
    section.heading,
    section.text,
    section.quote,
    ...(section.bullets ?? []),
    ...(section.ordered ?? []),
    ...(section.table?.rows.flat() ?? []),
  ]),
  ...guide.steps,
  ...guide.tips,
  ...(guide.ingredients ?? []),
  ...(guide.variations ?? []),
  ...(guide.storage ?? []),
  ...(guide.faqs ?? []).flatMap((faq) => [faq.question, faq.answer]),
);
// ~1,200 words is where scrolling to a section beats scrolling past it.
const showToc = toc.length >= 5 && guideWords >= 1200;

const quickFacts = guide.quickFacts ?? [
  { label: 'Best heat', value: guide.heat },
  { label: 'Cut', value: guide.cut },
  { label: 'Cook time', value: primaryCookTime },
  { label: 'Finish', value: guide.finish },
];

// Recipe schema (Google rich results) when the guide has a full ingredient list;
// Article schema otherwise. HowTo is deliberately not used: Google dropped HowTo
// rich results in 2023.
const contentSchema = guide.ingredients
  ? {
      '@context': 'https://schema.org',
      '@type': 'Recipe',
      name: guide.recipeName ?? guide.title,
      description: guide.description,
      image: imageUrl,
      author,
      publisher,
      datePublished: guide.updated,
      dateModified: guide.updated,
      prepTime: guide.prepIsoTime,
      cookTime: guide.isoTime,
      totalTime: totalIsoTime,
      recipeYield: guide.yieldText,
      keywords: [guide.label, 'mushroom recipe', ...guide.pairings].join(', '),
      recipeIngredient: guide.ingredients,
      recipeInstructions: guide.steps.map((text, index) => ({ '@type': 'HowToStep', position: index + 1, text })),
      mainEntityOfPage: pageUrl,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: guide.title,
      description: guide.description,
      image: imageUrl,
      author,
      publisher,
      datePublished: guide.updated,
      dateModified: guide.updated,
      mainEntityOfPage: pageUrl,
    };
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cookmushroom.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://cookmushroom.com/guides/' },
    { '@type': 'ListItem', position: 3, name: guide.title, item: pageUrl },
  ],
};
const schema = [contentSchema, breadcrumbSchema];
---
<Layout title={seoTitle} description={guide.description} schema={schema} heroImage={guide.image} heroImageSrcset={heroImageSrcset} heroImageSizes={heroImageSizes} heroImageAlt={guide.imageAlt} ogType="article">
  <main id="content" class="guide">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/guides/">Guides</a> › <span>{guide.label}</span>
    </nav>
    <p class="eyebrow">Guide · {guide.minutes}</p>
    <h1>{guide.title}</h1>
    <p class="lead">{guide.description}</p>
    <p class="updated">By <a href="/about/">Ana</a> · Updated {updatedDisplay}</p>
    <ShareRow url={pageUrl} title={guide.title} image={imageUrl} description={guide.description} />
    <div class="notice">Use store-bought or positively identified edible mushrooms. Identification notes on this page are safety reminders, not a foraging manual — never eat a wild mushroom without expert verification.</div>

    {guide.image && <img class="guide-hero-image" src={guide.image} srcset={heroImageSrcset} sizes={heroImageSrcset ? heroImageSizes : undefined} alt={guide.imageAlt ?? guide.title} width="1200" height="800" loading="eager" decoding="async" fetchpriority="high" />}

    <section class="quick-grid" aria-label="Quick answer">
      {quickFacts.map((fact) => <div class="fact"><span>{fact.label}</span><strong>{fact.value}</strong></div>)}
    </section>
    <p class="chart-link">
      {guide.ingredients && <a href="#recipe">Jump to the recipe ↓</a>}
      {guide.ingredients && ' · '}
      <a href="/mushroom-cook-time-chart/">Compare all cook times →</a>
    </p>

    {showToc && (
      <details class="toc" open>
        <summary>In this guide</summary>
        <ol>{toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
      </details>
    )}

    <article class="prose">
      {guide.sections?.map((section) => (
        <section id={slugify(section.heading)}>
          <h2>{section.heading}</h2>
          {section.image && <img src={section.image.src} alt={section.image.alt} loading="lazy" />}
          {section.text && (Array.isArray(section.text) ? section.text.map((para) => <p set:html={inlineMarkup(para)} />) : <p set:html={inlineMarkup(section.text)} />)}
          {section.quote && <blockquote>{section.quote}</blockquote>}
          {section.bullets && <ul>{section.bullets.map((item) => <li set:html={inlineMarkup(item)} />)}</ul>}
          {section.ordered && <ol>{section.ordered.map((item) => <li set:html={inlineMarkup(item)} />)}</ol>}
          {section.table && (
            <div class="table-wrap compact">
              <table>
                <thead><tr>{section.table.headings.map((heading) => <th>{heading}</th>)}</tr></thead>
                <tbody>{section.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      {guide.ingredients ? (
        <section id={methodId} class="recipe-block">
          <h2>{guide.recipeName ?? 'The recipe'}</h2>
          <p class="recipe-meta">
            {guide.prepIsoTime && <span>Prep: {prepMinutes ?? guide.prepIsoTime} min</span>}
            <span>Cook: {cookMinutes ? `${cookMinutes} min` : primaryCookTime}</span>
            {guide.yieldText && <span>Yield: <span data-yield>{guide.yieldText}</span></span>}
          </p>
          <CookMode storageKey={guide.slug} />
          <h3>Ingredients</h3>
          <ul class="checklist">
            {guide.ingredients.map((item, index) => (
              <li><label><input type="checkbox" data-check={`ing-${index}`} /><span>{item}</span></label></li>
            ))}
          </ul>
          <h3>Instructions</h3>
          <ol class="checklist">
            {guide.steps.map((step, index) => (
              <li><label><input type="checkbox" data-check={`step-${index}`} /><span>{step}</span></label></li>
            ))}
          </ol>
        </section>
      ) : (
        <section id={methodId}>
          <h2>{methodHeading}</h2>
          <ol>{guide.steps.map((step) => <li>{step}</li>)}</ol>
        </section>
      )}

      {guide.showCookTimes !== false && relatedRows.length > 0 && (
        <section id="cook-times">
          <h2>Cook times</h2>
          <div class="table-wrap compact">
            <table>
              <thead><tr><th>Method</th><th>Time</th><th>Done when</th></tr></thead>
              <tbody>
                {relatedRows.map((row) => <tr><td>{row.method}</td><td>{row.time}</td><td>{row.done}</td></tr>)}
              </tbody>
            </table>
          </div>
        </section>
      )}
      <section id="small-fixes">
        <h2>Small fixes that matter</h2>
        <ul>{guide.tips.map((tip) => <li set:html={inlineMarkup(tip)} />)}</ul>
      </section>
      {guide.variations && (
        <section id="variations">
          <h2>Variations</h2>
          <ul>{guide.variations.map((item) => <li set:html={inlineMarkup(item)} />)}</ul>
        </section>
      )}
      {guide.storage && (
        <section id="storage">
          <h2>Storage and reheating</h2>
          <ul>{guide.storage.map((item) => <li set:html={inlineMarkup(item)} />)}</ul>
        </section>
      )}
      {guide.faqs && (
        <section id="faqs">
          <h2>Frequently asked questions</h2>
          {guide.faqs.map((faq) => (
            <details class="faq">
              <summary><h3>{faq.question}</h3></summary>
              <p set:html={inlineMarkup(faq.answer)} />
            </details>
          ))}
        </section>
      )}
      <section>
        <h2>Good with</h2>
        <p>{guide.pairings.join(', ')}.</p>
      </section>
      <ShareRow url={pageUrl} title={guide.title} image={imageUrl} description={guide.description} label="Cooked this?" position="bottom" />
      {guide.relatedLinks && guide.relatedLinks.length > 0 && (
        <RelatedCards links={guide.relatedLinks} heading="Related guides" />
      )}
      {relatedRecipes.length > 0 && (
        <RelatedCards links={relatedRecipes.map((recipe) => ({ href: recipe.href, label: recipe.name }))} heading="Use it in" />
      )}
      {guide.sources && guide.sources.length > 0 && (
        <section>
          <h2>Sources</h2>
          <ul>{guide.sources.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>
        </section>
      )}
    </article>
  </main>
</Layout>
