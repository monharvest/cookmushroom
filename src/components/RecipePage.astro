---
import Layout from '../layouts/Layout.astro';
import type { RecipeArticle } from '../data/recipes';
import ShareRow from './ShareRow.astro';
import CookMode from './CookMode.astro';
import { inlineMarkup } from '../lib/richtext';
import RelatedCards from './RelatedCards.astro';

const { recipe } = Astro.props as { recipe: RecipeArticle };
const seoTitle = recipe.title.length + ' | CookMushroom'.length <= 60 ? `${recipe.title} | CookMushroom` : recipe.title;
const updatedDisplay = new Date(`${recipe.updated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const imageUrl = new URL(recipe.image, 'https://cookmushroom.com').toString();
const heroImageSizes = '(max-width: 720px) 100vw, (max-width: 1120px) 90vw, 960px';
const heroImageSrcset = [600, 900, 1200].map((width) => `${width === 1200 ? recipe.image : recipe.image.replace(/\.webp$/, `-${width}.webp`)} ${width}w`).join(', ');
const author = { '@type': 'Person', name: 'Ana' };
const publisher = {
  '@type': 'Organization',
  name: 'CookMushroom',
  url: 'https://cookmushroom.com/about/',
  logo: { '@type': 'ImageObject', url: 'https://cookmushroom.com/logo.png' },
};
const pageUrl = new URL(`/${recipe.slug}/`, 'https://cookmushroom.com').toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.recipeName,
  description: recipe.description,
  image: imageUrl,
  author,
  publisher,
  datePublished: recipe.updated,
  dateModified: recipe.updated,
  prepTime: recipe.prepIsoTime,
  cookTime: recipe.cookIsoTime,
  totalTime: recipe.totalIsoTime,
  recipeYield: recipe.yieldText,
  recipeCategory: recipe.recipeCategory,
  cookingMethod: recipe.cookingMethod,
  recipeCuisine: recipe.recipeCuisine,
  keywords: [...recipe.keywords, ...recipe.pairings].join(', '),
  recipeIngredient: recipe.ingredients,
  recipeInstructions: recipe.steps.map((text, index) => ({ '@type': 'HowToStep', position: index + 1, text })),
  mainEntityOfPage: pageUrl,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cookmushroom.com/' },
    { '@type': 'ListItem', position: 2, name: 'Recipe ideas', item: 'https://cookmushroom.com/mushroom-recipe-index/' },
    { '@type': 'ListItem', position: 3, name: recipe.title, item: pageUrl },
  ],
};
const minutesOf = (iso: string) => iso.match(/^PT(\d+)M$/)?.[1] ?? iso;
// Section count doesn't discriminate: the fixed sections (method, cook times,
// fixes, storage, FAQs) push every guide to ~8 entries regardless of depth, so
// a 750-word page would get the same contents box as a 2,300-word one. Gate on
// how much text is actually on the page instead.
const countWords = (...parts: (string | string[] | undefined)[]) =>
  parts.flat().filter(Boolean).join(' ').trim().split(/\s+/).filter(Boolean).length;

// Same construction as GuidePage: built from the rendered data, tail skipped.
const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const toc = [
  ...(recipe.sections ?? []).map((section) => ({ id: slugify(section.heading), label: section.heading })),
  { id: 'recipe', label: recipe.recipeName },
  { id: 'small-fixes', label: 'Small fixes that matter' },
  { id: 'storage', label: 'Storage and reheating' },
  ...(recipe.faqs ? [{ id: 'faqs', label: 'Frequently asked questions' }] : []),
];
const recipeWords = countWords(
  recipe.description,
  ...(recipe.sections ?? []).flatMap((section) => [
    section.heading,
    section.text,
    section.quote,
    ...(section.bullets ?? []),
    ...(section.ordered ?? []),
    ...(section.table?.rows.flat() ?? []),
  ]),
  ...recipe.ingredients,
  ...recipe.steps,
  ...recipe.tips,
  ...recipe.storage,
  ...(recipe.faqs ?? []).flatMap((faq) => [faq.question, faq.answer]),
);
const showToc = toc.length >= 5 && recipeWords >= 1200;
---
<Layout title={seoTitle} description={recipe.description} schema={[schema, breadcrumbSchema]} heroImage={recipe.image} heroImageSrcset={heroImageSrcset} heroImageSizes={heroImageSizes} heroImageAlt={recipe.imageAlt} ogType="article">
  <main id="content" class="guide">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/mushroom-recipe-index/">Recipe ideas</a> › <span>{recipe.title}</span></nav>
    <p class="eyebrow">Recipe · {recipe.minutes}</p>
    <h1>{recipe.title}</h1>
    <p class="lead">{recipe.description}</p>
    <p class="updated">By <a href="/about/">Ana</a> · Updated {updatedDisplay}</p>
    <ShareRow url={pageUrl} title={recipe.title} image={imageUrl} description={recipe.description} />
    <img class="guide-hero-image" src={recipe.image} srcset={heroImageSrcset} sizes={heroImageSizes} alt={recipe.imageAlt} width="1200" height="800" loading="eager" decoding="async" fetchpriority="high" />
    {recipe.sections && recipe.sections.length > 0 && (
      <p class="chart-link"><a href="#recipe">Jump to the recipe ↓</a> · <a href="/mushroom-cook-time-chart/">Compare all cook times →</a></p>
    )}
    {showToc && (
      <details class="toc" open>
        <summary>In this recipe</summary>
        <ol>{toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
      </details>
    )}

    <article class="prose">
      {recipe.sections?.map((section) => (
        <section id={slugify(section.heading)}>
          <h2>{section.heading}</h2>
          {section.text && (Array.isArray(section.text) ? section.text.map((para) => <p set:html={inlineMarkup(para)} />) : <p set:html={inlineMarkup(section.text)} />)}
          {section.quote && <blockquote>{section.quote}</blockquote>}
          {section.bullets && <ul>{section.bullets.map((item) => <li set:html={inlineMarkup(item)} />)}</ul>}
          {section.ordered && <ol>{section.ordered.map((item) => <li set:html={inlineMarkup(item)} />)}</ol>}
        </section>
      ))}
      <section id="recipe" class="recipe-block">
        <h2>{recipe.recipeName}</h2>
        <p class="recipe-meta"><span>Prep: {minutesOf(recipe.prepIsoTime)} min</span><span>Cook: {minutesOf(recipe.cookIsoTime)} min</span><span>Yield: <span data-yield>{recipe.yieldText}</span></span></p>
        <CookMode storageKey={recipe.slug} />
        <h3>Ingredients</h3>
        <ul class="checklist">
          {recipe.ingredients.map((item, index) => (
            <li><label><input type="checkbox" data-check={`ing-${index}`} /><span>{item}</span></label></li>
          ))}
        </ul>
        <h3>Instructions</h3>
        <ol class="checklist">
          {recipe.steps.map((step, index) => (
            <li><label><input type="checkbox" data-check={`step-${index}`} /><span>{step}</span></label></li>
          ))}
        </ol>
      </section>
      <section id="small-fixes"><h2>Small fixes that matter</h2><ul>{recipe.tips.map((tip) => <li set:html={inlineMarkup(tip)} />)}</ul></section>
      <section><h2>Good with</h2><p>{recipe.pairings.join(', ')}.</p></section>
      <section id="storage"><h2>Storage and reheating</h2><ul>{recipe.storage.map((item) => <li set:html={inlineMarkup(item)} />)}</ul></section>
      {recipe.faqs && (
        <section id="faqs">
          <h2>Frequently asked questions</h2>
          {recipe.faqs.map((faq) => (
            <details class="faq">
              <summary><h3>{faq.question}</h3></summary>
              <p set:html={inlineMarkup(faq.answer)} />
            </details>
          ))}
        </section>
      )}
      <ShareRow url={pageUrl} title={recipe.title} image={imageUrl} description={recipe.description} label="Cooked this?" position="bottom" />
      <RelatedCards links={recipe.relatedLinks} heading="Related guides" />
    </article>
  </main>
</Layout>
