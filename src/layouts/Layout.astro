---
import '../styles/global.css';
const {
  title = 'CookMushroom — How to Cook Mushrooms Properly',
  description = 'CookMushroom is a focused guide to cooking mushrooms: cook times, pan methods, air-fryer tips, and simple mushroom recipes.',
  schema = [],
  heroImage,
  heroImageSrcset,
  heroImageSizes,
  heroImageAlt,
  ogType = 'website',
} = Astro.props;
const site = 'https://cookmushroom.com';
const canonical = new URL(Astro.url.pathname, site).toString();
const logo = `${site}/logo.png`;
// Social card: the page's own hero when it has one, so a shared guide or recipe
// shows that dish rather than the generic sitewide card. Points at the JPEG
// mirror from scripts/make-og-cards.sh — page images are WebP, but some link
// unfurlers still won't render WebP, and a card that fails costs the share.
// Every full-size hero has a matching -og.jpg, so the swap is always safe.
const socialCard = heroImage?.replace(/\.webp$/, '-og.jpg');
const socialImage = socialCard ? new URL(socialCard, site).toString() : `${site}/og-image.png`;
const socialImageAlt = heroImage ? (heroImageAlt ?? title) : 'CookMushroom — how to cook mushrooms properly';
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'CookMushroom', url: `${site}/`, description },
    { '@type': 'Organization', name: 'CookMushroom', url: `${site}/`, logo }
  ],
};
const schemas = [baseSchema, ...(Array.isArray(schema) ? schema : [schema]).filter(Boolean)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {heroImage && <link rel="preload" as="image" href={heroImage} imagesrcset={heroImageSrcset} imagesizes={heroImageSizes} fetchpriority="high" />}
    <meta property="og:site_name" content="CookMushroom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SP5SEQPV12" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SP5SEQPV12');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">Cook<span>Mushroom</span></a>
        <div class="nav-links">
          <a href="/guides/" aria-current={Astro.url.pathname.startsWith('/guides') ? 'page' : undefined}>Guides</a>
          <a href="/mushroom-cook-time-chart/" aria-current={Astro.url.pathname.startsWith('/mushroom-cook-time-chart') ? 'page' : undefined}>Cook Times</a>
          <a href="/mushroom-recipe-index/" aria-current={Astro.url.pathname.startsWith('/mushroom-recipe-index') ? 'page' : undefined}>Recipes</a>
          <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="footer">
      <p>CookMushroom covers cooking edible mushrooms. Identification notes are safety reminders only — never eat a wild mushroom without expert verification.</p>
      <p>Editorial policy: concise, practical guidance built around observable cooking cues and updated when cook-time pages change.</p>
      <p><a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a></p>
      <p>&copy; {new Date().getFullYear()} CookMushroom</p>
    </footer>
  </body>
</html>
