---
import '../styles/global.css';
const {
  title = 'CookMushroom — How to Cook Mushrooms Properly',
  description = 'CookMushroom is a focused guide to cooking mushrooms: cook times, pan methods, air-fryer tips, and simple mushroom recipes.',
  schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://cookmushroom.com').toString();
const image = 'https://cookmushroom.com/og-image.png';
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'CookMushroom', url: 'https://cookmushroom.com/', description },
    { '@type': 'Organization', name: 'CookMushroom', url: 'https://cookmushroom.com/', logo: image }
  ],
};
const schemas = [baseSchema, ...(Array.isArray(schema) ? schema : [schema]).filter(Boolean)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SP5SEQPV12" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SP5SEQPV12');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">Cook<span>Mushroom</span></a>
        <div class="nav-links">
          <a href="/guides/">Guides</a>
          <a href="/mushroom-cook-time-chart/">Cook Times</a>
          <a href="/mushroom-recipe-index/">Recipe ideas</a>
          <a href="/about/">About</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="footer">
      <p>CookMushroom covers cooking edible mushrooms. Identification notes are safety reminders only — never eat a wild mushroom without expert verification.</p>
      <p>Editorial policy: concise, practical guidance built around observable cooking cues and updated when cook-time pages change.</p>
      <p><a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a></p>
      <p>&copy; {new Date().getFullYear()} CookMushroom</p>
    </footer>
  </body>
</html>
