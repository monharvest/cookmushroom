---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
const {
  title = 'CookMushroom — How to Cook Mushrooms Properly',
  description = 'CookMushroom is a focused guide to cooking mushrooms: cook times, pan methods, air-fryer tips, and simple mushroom recipes.',
  schema = [],
  heroImage,
  heroImageSrcset,
  heroImageSizes,
  heroImageAlt,
  ogType = 'website',
  noindex = false,
  ads = true,
} = Astro.props;
// Google AdSense (Auto ads): one deferred loader in the head (it injects
// adsbygoogle.js after the page has painted), Google places the units.
// Not on noindex pages (/search/) or the 404 — AdSense policy forbids ads on
// pages without publisher content. CSP for it lives in public/_headers.
const ADSENSE_CLIENT = 'ca-pub-1320198648576974';
const showAds = ads && !noindex;
const site = 'https://cookmushroom.com';
const canonical = new URL(Astro.url.pathname, site).toString();
const logo = `${site}/logo.png`;
// Social card: the page's own hero when it has one, so a shared guide or recipe
// shows that dish rather than the generic sitewide card. Points at the JPEG
// mirror from scripts/make-og-cards.sh — page images are WebP, but some link
// unfurlers still won't render WebP, and a card that fails costs the share.
// Every full-size hero has a matching -og.jpg, so the swap is always safe.
const socialCard = heroImage?.replace(/\.webp$/, '-og.jpg');
const socialImage = socialCard ? new URL(socialCard, site).toString() : `${site}/og-image.png`;
const socialImageAlt = heroImage ? (heroImageAlt ?? title) : 'CookMushroom — how to cook mushrooms properly';
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'CookMushroom', url: `${site}/`, description },
    { '@type': 'Organization', name: 'CookMushroom', url: `${site}/`, logo }
  ],
};
const schemas = [baseSchema, ...(Array.isArray(schema) ? schema : [schema]).filter(Boolean)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before any CSS applies: the header shows its JS menu only when this ran. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {heroImage && <link rel="preload" as="image" href={heroImage} imagesrcset={heroImageSrcset} imagesizes={heroImageSizes} fetchpriority="high" />}
    <meta property="og:site_name" content="CookMushroom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {showAds && (
      <script is:inline data-ad-client={ADSENSE_CLIENT}>
        // Deferred AdSense loader: the page paints first, ads follow. Loads once,
        // after the first painted frame once the browser is idle, or on the first
        // scroll, tap or key press, whichever comes first.
        (function () {
          var client = document.currentScript.dataset.adClient, done = false;
          function load() {
            if (done) return;
            done = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
            document.head.appendChild(s);
          }
          ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
            addEventListener(e, load, { once: true, passive: true });
          });
          // After load, wait for a frame to be painted (rAF, then a task after
          // it), then for idle time, so the ad code never delays first paint.
          addEventListener('load', function () {
            requestAnimationFrame(function () {
              setTimeout(function () {
                if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
                else setTimeout(load, 1000);
              }, 0);
            });
          });
        })();
      </script>
    )}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SP5SEQPV12" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SP5SEQPV12');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <slot />
    <footer class="footer">
      <p>CookMushroom covers cooking edible mushrooms. Identification notes are safety reminders only — never eat a wild mushroom without expert verification.</p>
      <p>Editorial policy: concise, practical guidance built around observable cooking cues and updated when cook-time pages change.</p>
      <p>As an Amazon Associate I earn from qualifying purchases.</p>
      <p><a href="/privacy/">Privacy</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/contact/">Contact</a></p>
      <p>&copy; {new Date().getFullYear()} CookMushroom</p>
    </footer>
  </body>
</html>
