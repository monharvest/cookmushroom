---
import Layout from '../layouts/Layout.astro';
import { recipes, guideArticles } from '../data/guides';
---
<Layout title="Mushroom Recipe Index | CookMushroom" description="Simple mushroom recipe ideas organized by weeknight mains, meatless favorites, sides, and breakfast.">
  <main>
    <p class="eyebrow">Recipes</p>
    <h1>Mushroom recipe index</h1>
    <p class="lead">A practical index for what to cook after you know the method.</p>
    <section class="recipe-list section">
      {recipes.map((group) => (
        <article class="card">
          <h2>{group.group}</h2>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </section>
    <section class="section">
      <h2>Technique first</h2>
      <div class="grid">
        {guideArticles.slice(0, 3).map((guide) => (
          <a class="card" href={`/${guide.slug}/`}><h3>{guide.title}</h3><p>{guide.description}</p></a>
        ))}
      </div>
    </section>
  </main>
</Layout>
