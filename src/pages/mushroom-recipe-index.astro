---
import Layout from '../layouts/Layout.astro';
import { recipeCards } from '../data/guides';
---
<Layout title="Mushroom Recipe Ideas | CookMushroom" description="Browse mushroom recipe ideas by variety, cooking method, and total time, with each dish linked to its complete preparation guide.">
  <main id="content">
    <p class="eyebrow">Recipe ideas</p>
    <h1>Mushroom recipe ideas</h1>
    <p class="lead">No filler recipes: just quick ideas tied back to the right mushroom cooking method.</p>
    <section class="recipe-list section">
      {recipeCards.map((recipe) => (
        <a class="card recipe-card" href={`/${recipe.guide}/`}>
          <span class="badge">{recipe.time}</span>
          <h2>{recipe.name}</h2>
          <p>{recipe.description}</p>
          <small>Best mushroom: {recipe.mushroom}</small>
        </a>
      ))}
    </section>
  </main>
</Layout>
