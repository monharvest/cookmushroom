---
import Layout from '../layouts/Layout.astro';
import { guideArticles } from '../data/guides';
const methodGuides = guideArticles.filter((guide) => !guide.mushroomSlug && guide.group !== 'storage');
const storageGuides = guideArticles.filter((guide) => guide.group === 'storage');
const mushroomGuides = guideArticles.filter((guide) => guide.mushroomSlug);
---
<Layout title="Mushroom Cooking Guides | CookMushroom" description="Browse practical mushroom cooking guides with exact times, heat levels, preparation steps, doneness cues, and safety reminders.">
  <main id="content">
    <p class="eyebrow">Guides</p>
    <h1>Mushroom cooking guides</h1>
    <p class="lead">Short, useful pages for getting mushrooms browned, tender, safely handled, and properly seasoned.</p>
    <div class="filter" hidden data-filter>
      <label class="filter-label" for="guide-filter">Find a guide</label>
      <input id="guide-filter" type="search" placeholder="shiitake, freezing, air fryer…" autocomplete="off" spellcheck="false" />
      <p class="filter-count" role="status" data-filter-count></p>
    </div>
    <section class="section" data-group>
      <p class="eyebrow">Method guides</p>
      <div class="grid">
        {methodGuides.map((guide) => (
          <a class="card" href={`/${guide.slug}/`}>
            <span class="badge">{guide.minutes}</span>
            <h2>{guide.title}</h2>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="section" data-group>
      <p class="eyebrow">Storage &amp; prep</p>
      <div class="grid">
        {storageGuides.map((guide) => (
          <a class="card" href={`/${guide.slug}/`}>
            <span class="badge">{guide.minutes}</span>
            <h2>{guide.title}</h2>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="section" data-group>
      <p class="eyebrow">By mushroom</p>
      <div class="grid">
        {mushroomGuides.map((guide) => (
          <a class="card" href={`/${guide.slug}/`}>
            <span class="badge">{guide.minutes}</span>
            <h2>{guide.title}</h2>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    // Filters the cards already on the page — no search index to build, ship or
    // keep in sync. Revealed only once the script runs, so a reader without JS
    // never sees a box that would do nothing.
    const wrap = document.querySelector<HTMLElement>('[data-filter]');
    const input = document.querySelector<HTMLInputElement>('#guide-filter');
    const count = document.querySelector<HTMLElement>('[data-filter-count]');
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

    if (wrap && input && groups.length) {
      wrap.hidden = false;
      const cards = groups.flatMap((group) =>
        Array.from(group.querySelectorAll<HTMLAnchorElement>('.card')).map((el) => ({
          el,
          group,
          text: (el.textContent ?? '').toLowerCase(),
        })),
      );

      const apply = () => {
        const query = input.value.trim().toLowerCase();
        const terms = query.split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const card of cards) {
          const match = terms.every((term) => card.text.includes(term));
          card.el.hidden = !match;
          if (match) shown += 1;
        }
        // Hide a heading whose cards have all gone.
        for (const group of groups) {
          group.hidden = !cards.some((c) => c.group === group && !c.el.hidden);
        }
        if (count) {
          count.textContent = !terms.length
            ? ''
            : shown === 0
              ? `No guides match “${input.value.trim()}”.`
              : `${shown} of ${cards.length} guides`;
        }
      };

      input.addEventListener('input', apply);
      // Escape clears, which is what a search field is expected to do.
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { input.value = ''; apply(); }
      });
    }
  </script>
</Layout>
