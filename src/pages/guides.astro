---
import Layout from '../layouts/Layout.astro';
import { guideArticles } from '../data/guides';
---
<Layout title="Mushroom Cooking Guides | CookMushroom" description="Practical guides for cooking button, oyster, lion's mane, enoki, shiitake, and portobello mushrooms.">
  <main>
    <p class="eyebrow">Guides</p>
    <h1>Mushroom cooking guides</h1>
    <p class="lead">Short, useful pages for getting mushrooms browned, tender, and properly seasoned.</p>
    <div class="grid section">
      {guideArticles.map((guide) => (
        <a class="card" href={`/${guide.slug}/`}>
          <span class="badge">{guide.minutes}</span>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
