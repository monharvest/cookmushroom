---
import Layout from '../layouts/Layout.astro';
import { cookTimes, guideArticles, recipes } from '../data/guides';
const featured = guideArticles.slice(0, 6);
---
<Layout>
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">Mushrooms, cooked correctly</p>
        <h1>Brown them. Don’t steam them.</h1>
        <p class="lead">CookMushroom is a focused reference for mushroom cook times, pan methods, air-fryer tips, and simple recipe ideas.</p>
        <div class="actions">
          <a class="button" href="/mushroom-cook-time-chart/">Use the cook-time chart</a>
          <a class="button secondary" href="/guides/">Browse guides</a>
        </div>
      </div>
      <aside class="panel" aria-label="Quick mushroom cooking rules">
        <span class="badge">Quick rules</span>
        <ul>
          <li>Use a wide hot pan.</li>
          <li>Do not crowd the mushrooms.</li>
          <li>Salt after the first browning.</li>
          <li>Add butter, garlic, or sauce near the end.</li>
        </ul>
      </aside>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>Cooking guides</h2>
        </div>
        <p>No wild mushroom identification; just practical cooking for edible mushrooms.</p>
      </div>
      <div class="grid">
        {featured.map((guide) => (
          <a class="card" href={`/${guide.slug}/`}>
            <span class="badge">{guide.minutes}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Fast answer</p>
          <h2>Common cook times</h2>
        </div>
        <p><a href="/mushroom-cook-time-chart/">Open the full chart →</a></p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Mushroom</th><th>Method</th><th>Time</th><th>Done when</th></tr></thead>
          <tbody>
            {cookTimes.slice(0, 6).map((row) => (
              <tr><td>{row.mushroom}</td><td>{row.method}</td><td>{row.time}</td><td>{row.done}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Recipe lanes</p>
          <h2>What to cook next</h2>
        </div>
        <p><a href="/mushroom-recipe-index/">Open recipe index →</a></p>
      </div>
      <div class="recipe-list">
        {recipes.map((group) => (
          <article class="card">
            <h3>{group.group}</h3>
            <ul>{group.items.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
