---
import Layout from '../layouts/Layout.astro';
import { cookTimes } from '../data/guides';
const mushrooms = [...new Map(cookTimes.map((row) => [row.mushroomSlug, row.mushroom])).entries()];
const methods = cookTimes.reduce((items, row) => items.some(([slug]) => slug === row.methodSlug) ? items : [...items, [row.methodSlug, row.method]], []);
---
<Layout title="Mushroom Cook Time Chart | CookMushroom" description="Compare mushroom cook times by variety and method, including heat, oil amount, total time, and the visual signs that each mushroom is done.">
  <main id="content">
    <p class="eyebrow">Cook-time chart</p>
    <h1>Mushroom cook time chart</h1>
    <p class="lead">Pick a mushroom and method. If a pair is not listed, use the closest texture match.</p>

    <section class="tool-card" aria-labelledby="tool-title">
      <h2 id="tool-title">Find a cook time</h2>
      <div class="controls">
        <label>Mushroom
          <select id="mushroom">
            {mushrooms.map(([slug, name]) => <option value={slug}>{name}</option>)}
          </select>
        </label>
        <label>Method
          <select id="method">
            {methods.map(([slug, name]) => <option value={slug}>{name}</option>)}
          </select>
        </label>
      </div>
      <div id="result" class="result" aria-live="polite"></div>
    </section>

    <section class="section">
      <h2>Full table</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Mushroom</th><th>Method</th><th>Time</th><th>Heat</th><th>Fat</th><th>Done when</th></tr></thead>
          <tbody>
            {cookTimes.map((row) => (
              <tr><td>{row.mushroom}</td><td>{row.method}</td><td>{row.time}</td><td>{row.heat}</td><td>{row.fat}</td><td>{row.done}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <script id="cook-time-data" type="application/json" set:html={JSON.stringify(cookTimes)} is:inline></script>
  <script>
    type Row = { mushroom: string; mushroomSlug: string; method: string; methodSlug: string; time: string; heat: string; fat: string; done: string };
    const dataEl = document.getElementById('cook-time-data') as HTMLScriptElement | null;
    const mushroom = document.getElementById('mushroom') as HTMLSelectElement | null;
    const method = document.getElementById('method') as HTMLSelectElement | null;
    const result = document.getElementById('result');
    if (!dataEl || !mushroom || !method || !result) throw new Error('Cook time controls missing');
    const rows = JSON.parse(dataEl.textContent || '[]') as Row[];
    function render() {
      const row = rows.find((item) => item.mushroomSlug === mushroom.value && item.methodSlug === method.value) || rows.find((item) => item.mushroomSlug === mushroom.value);
      if (!row) return;
      result.innerHTML = `<h3>${row.mushroom} · ${row.method}</h3><dl><dt>Time</dt><dd>${row.time}</dd><dt>Heat</dt><dd>${row.heat}</dd><dt>Fat</dt><dd>${row.fat}</dd><dt>Done when</dt><dd>${row.done}</dd></dl>`;
    }
    mushroom.addEventListener('change', render);
    method.addEventListener('change', render);
    render();
  </script>
</Layout>
