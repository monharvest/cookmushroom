---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact CookMushroom" description="Contact CookMushroom with cooking questions, corrections, or feedback about a mushroom guide.">
  <main id="content" class="guide">
    <p class="eyebrow">Contact</p>
    <h1>Contact CookMushroom</h1>
    <article class="prose">
      <p>Send cooking questions, corrections, or site feedback to <a href="mailto:hello@cookmushroom.com">hello@cookmushroom.com</a>.</p>
      <p>For a correction, include the page URL and the exact line or cooking step you are referring to.</p>
      <p>CookMushroom cannot identify wild mushrooms from descriptions or photographs. Ask a qualified local expert before eating anything foraged.</p>
    </article>
  </main>
</Layout>