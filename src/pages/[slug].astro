---
// Root-level router. Guides and recipes share the same URL space (/<slug>/),
// so a single dynamic route dispatches to the matching page component.
import GuidePage from '../components/GuidePage.astro';
import RecipePage from '../components/RecipePage.astro';
import { guideArticles } from '../data/guides';
import { recipeArticles } from '../data/recipes';

export function getStaticPaths() {
  return [
    ...guideArticles.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })),
    ...recipeArticles.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } })),
  ];
}

const { guide, recipe } = Astro.props;
---
{recipe ? <RecipePage recipe={recipe} /> : <GuidePage guide={guide} />}
